---
import { href } from '../lib/url';

const cols = [
  {
    title: 'Product',
    links: [
      { label: 'The Brain', href: href('/cerebro') },
      { label: 'AI & Chat', href: href('/ia') },
      { label: 'CLI', href: href('/cli') },
      { label: 'Sync & Privacy', href: href('/sync') },
      { label: 'Themes', href: href('/temas') },
    ],
  },
  {
    title: 'Get it',
    links: [
      { label: 'Download', href: href('/download') },
      { label: 'Releases', href: 'https://github.com/yagoid/noteflow/releases' },
      { label: 'Source', href: 'https://github.com/yagoid/noteflow' },
      { label: 'Issues', href: 'https://github.com/yagoid/noteflow/issues' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: href('/mobile-privacy-policy') },
      { label: 'License (FSL-1.1)', href: 'https://github.com/yagoid/noteflow/blob/main/LICENSE' },
    ],
  },
];
---

<footer class="mt-32 border-t border-border/60">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2.5 font-display font-semibold">
        <span class="grid h-7 w-7 place-items-center rounded-md border border-border bg-surface-2 text-accent" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" />
            <circle cx="5" cy="6" r="1.5" /><circle cx="19" cy="7" r="1.5" /><circle cx="6" cy="18" r="1.5" /><circle cx="18" cy="17" r="1.5" />
          </svg>
        </span>
        NoteFlow
      </div>
      <p class="mt-3 max-w-xs text-sm text-text-muted">Your notes, wired like a second brain. Local-first, developer-native.</p>
    </div>
    {cols.map((c) => (
      <div>
        <p class="kicker mb-3">{c.title}</p>
        <ul class="space-y-2">
          {c.links.map((l) => (
            <li><a href={l.href} class="fire text-sm text-text-muted hover:text-text">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="container-x flex flex-col gap-2 border-t border-border/60 py-6 text-xs text-text-muted sm:flex-row sm:items-center sm:justify-between">
    <span>Built by yagoid · Functional Source License 1.1</span>
    <span class="font-mono">Windows · Linux · CLI</span>
  </div>
</footer>
