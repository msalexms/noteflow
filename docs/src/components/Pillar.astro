---
// One pillar block hanging off the axon rail. The node fires (its signal colour) when revealed.
// Default slot = body copy; named slot "visual" = the right/left media.
import { href as link } from '../lib/url';

interface Props {
  n: string; // '01'
  kicker: string;
  title: string;
  signal: string; // CSS var, e.g. '--accent'
  to?: string; // internal path
  linkLabel?: string;
  reverse?: boolean;
}
const { n, kicker, title, signal, to, linkLabel, reverse = false } = Astro.props;
---

<div class="pillar reveal" style={`--signal: var(${signal})`}>
  <span class="axon-node"></span>
  <div class="grid items-center gap-8 md:gap-14 lg:grid-cols-2">
    <div class={reverse ? 'lg:order-2' : ''}>
      <p class="kicker">
        <span class="text-[rgb(var(--signal))]">{n}</span> · {kicker}
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl">{title}</h2>
      <div class="mt-4 max-w-md leading-relaxed text-text-muted">
        <slot />
      </div>
      {to && (
        <a href={link(to)} class="fire mt-6 inline-flex items-center gap-1.5 font-mono text-sm text-[rgb(var(--signal))]">
          {linkLabel ?? 'Learn more'} →
        </a>
      )}
    </div>
    <div class={reverse ? 'lg:order-1' : ''}>
      <slot name="visual" />
    </div>
  </div>
</div>
