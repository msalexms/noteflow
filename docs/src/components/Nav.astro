---
import { href } from '../lib/url';
import ThemeToggle from './ThemeToggle.tsx';

const links = [
  { label: 'Brain', path: '/cerebro', signal: '--accent' },
  { label: 'AI', path: '/ia', signal: '--purple' },
  { label: 'CLI', path: '/cli', signal: '--accent-2' },
  { label: 'Sync', path: '/sync', signal: '--cyan' },
  { label: 'Themes', path: '/temas', signal: '--orange' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (p: string) => path === href(p).replace(/\/$/, '');
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border/60 bg-surface-0/70 backdrop-blur-md" style={`height: var(--nav-h)`}>
  <nav class="container-x flex h-full items-center justify-between gap-6">
    <a href={href('/')} class="flex items-center gap-2.5 font-display text-[15px] font-semibold tracking-tight">
      <span class="grid h-7 w-7 place-items-center rounded-md border border-border bg-surface-2 text-accent" aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" />
          <circle cx="5" cy="6" r="1.5" /><circle cx="19" cy="7" r="1.5" /><circle cx="6" cy="18" r="1.5" /><circle cx="18" cy="17" r="1.5" />
          <path d="M12 12 5 6M12 12l7-5M12 12 6 18M12 12l6 5" stroke-width="1" />
        </svg>
      </span>
      NoteFlow
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {links.map((l) => (
        <a
          href={href(l.path)}
          class="fire text-sm text-text-muted hover:text-text"
          style={`--signal: var(${l.signal})`}
          aria-current={isActive(l.path) ? 'page' : undefined}
          data-active={isActive(l.path)}
        >
          {l.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a href={href('/download')} class="btn btn-primary hidden sm:inline-flex">Download</a>
      <a href="https://github.com/yagoid/noteflow" target="_blank" rel="noopener" class="fire text-text-muted hover:text-text" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.75.4-1.27.74-1.56-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
      </a>
      <ThemeToggle client:load />
    </div>
  </nav>
</header>

<style>
  a[data-active='true'] {
    color: rgb(var(--text));
  }
</style>
