                <div style="display:flex;align-items:center;gap:10px;background:var(--card-2);border:1px solid var(--line);border-radius:9px;padding:9px 12px;"><span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-faint);width:64px;">Albums</span><span style="font-size:16px;color:var(--ink-dim);">3 added</span></div>
                <div style="display:flex;align-items:center;gap:10px;background:var(--card-2);border:1px solid var(--line);border-radius:9px;padding:9px 12px;"><span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-faint);width:64px;">Dream trip</span><span style="font-size:16px;color:var(--ink-dim);">Patagonia, slow</span></div>
