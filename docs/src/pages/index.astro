                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;"><span style="font-size:17px;color:var(--ink-dim);">Deadlines</span><span style="display:inline-flex;border:1px solid var(--line-2);border-radius:9px;overflow:hidden;font-size:12px;font-family:'JetBrains Mono',monospace;"><span style="padding:7px 12px;background:rgb(var(--orange)/.18);color:rgb(var(--orange));">Early</span><span style="padding:7px 12px;color:var(--ink-faint);">Last minute</span></span></div>
              </div>
              <div style="height:1px;background:var(--line);"></div>
