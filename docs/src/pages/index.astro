---
import Base from '../layouts/Base.astro';
import { asset } from '../lib/url';

const RELEASES = 'https://github.com/yagoid/noteflow/releases';
// Showcase clip: an in-app screen recording, one per theme. The poster (static PNG) shows
// while the video loads and is the fallback if autoplay is blocked.
const VID_DARK = asset('/video/demo-dark.mp4');
const VID_DARK_WEBM = asset('/video/demo-dark.webm');
const VID_LIGHT = asset('/video/demo-light.mp4');
const VID_LIGHT_WEBM = asset('/video/demo-light.webm');
const SHOT_DARK = asset('/screenshots/app-main-midnightblue.png');
const SHOT_LIGHT = asset('/screenshots/app-main-articday.png');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NoteFlow',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Windows, Linux',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: 'https://yagoid.github.io/noteflow/',
  downloadUrl: 'https://github.com/yagoid/noteflow/releases',
  description:
    'A local-first second brain for developers: markdown notes, a 3D neural graph, agentic AI chat, a headless CLI, and private GitHub sync.',
};

// Reusable inline style fragments (kept verbatim from the design for a faithful port).
const label =
  "font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--ink-faint);";
const cardP = 'margin:0;font-size:17px;line-height:1.5;color:var(--ink-dim);';

// ── Notes section: the feature set drawn as a *real* NoteFlow window ──
// Left = the app sidebar (each feature is a note, in colour-coded groups). Right =
// a faithful section-preview card (the editor mock) that swaps when a note is picked.
// `tok` is a palette token (rgb triplet) that tints the section tag + the card accent.
// `body` blocks are rendered as a mini note, so all the marketing copy ships in the
// static HTML for SEO. Keep this in sync with the markup + the page script below.
type NoteBlock =
  | { t: 'p'; html: string }
  | { t: 'ul'; items: string[] }
  | { t: 'check'; items: { done: boolean; text: string }[] }
  | { t: 'kbd'; keys: string[] }
  | { t: 'code'; lines: string[] }
  | { t: 'tabs'; tabs: { name: string; tok: string }[] }
  | { t: 'groups'; rows: { name: string; tok: string; count: number }[] };

interface NoteFeature {
  id: string;
  tok: string;
  title: string;   // shown both in the sidebar item and as the note heading
  time: string;    // short modified time in the sidebar item (e.g. 21:34)
  date: string;    // full created line inside the card
  mode: 'rich' | 'raw';
  tags: { name: string; tok: string }[];
  body: NoteBlock[];
}

const noteFeatures: NoteFeature[] = [
  {
    id: 'brain', tok: 'purple', title: 'A brain that mirrors you',
    time: '22:10', date: 'Jun 24, 2026 · 22:10', mode: 'rich',
    tags: [{ name: 'Brain', tok: 'purple' }],
    body: [
      { t: 'p', html: 'NoteFlow turns your notes into a living <strong>3D neural graph</strong>. The more order you give them, the more legible your brain becomes — clusters form, neurons connect, structure emerges.' },
      { t: 'ul', items: ['Tidy groups → clean clusters', 'Linked notes → stronger connections', 'Each section is its own neuron'] },
      { t: 'p', html: 'Organize on the left, watch it take shape in the <code>Brain</code> view.' },
    ],
  },
  {
    id: 'headless', tok: 'cyan', title: 'Drive it headless',
    time: '20:48', date: 'Jun 21, 2026 · 20:48', mode: 'raw',
    tags: [{ name: 'CLI', tok: 'cyan' }],
    body: [
      { t: 'p', html: 'No screen? No problem. Run NoteFlow on a <strong>Raspberry Pi</strong>, a VPS or a home server through its companion CLI.' },
      { t: 'code', lines: ['$ ssh pi@home', '$ nf new "Backup plan" --group infra', '✓ created · synced'] },
      { t: 'p', html: 'Full control over your notes and groups from any terminal — perfect for scripts and pipelines.' },
    ],
  },
  {
    id: 'import', tok: 'orange', title: 'Bring your notes along',
    time: '18:33', date: 'Jun 17, 2026 · 18:33', mode: 'rich',
    tags: [{ name: 'Import', tok: 'orange' }],
    body: [
      { t: 'p', html: 'Switching is painless. Import what you already wrote elsewhere — NoteFlow speaks the formats you already use.' },
      { t: 'check', items: [
        { done: true, text: 'Notion exports' },
        { done: true, text: 'Obsidian vaults' },
        { done: true, text: 'Google Keep' },
        { done: false, text: '…and plain Markdown from anywhere' },
      ] },
    ],
  },
  {
    id: 'ai', tok: 'accent', title: 'AI that knows you',
    time: '16:05', date: 'Jun 14, 2026 · 16:05', mode: 'rich',
    tags: [{ name: 'Agent', tok: 'accent' }],
    body: [
      { t: 'p', html: 'The agent reads your <strong>profile</strong> and the full context of your notes before it answers — so its replies land closer to what you actually mean than any generic chat ever could.' },
      { t: 'ul', items: ['Knows who you are and how you work', 'Sees every note as context', 'Answers in your language, on your terms'] },
    ],
  },
  {
    id: 'sticky', tok: 'pink', title: 'Pin it to your desktop',
    time: '13:27', date: 'Jun 10, 2026 · 13:27', mode: 'rich',
    tags: [{ name: 'Sticky', tok: 'pink' }],
    body: [
      { t: 'p', html: 'Pop any note out as a <strong>sticky note</strong> that floats over your desktop — always in view while you work.' },
      { t: 'check', items: [
        { done: true, text: 'Stays on top, outside the main window' },
        { done: true, text: 'Edits sync straight back to the note' },
      ] },
    ],
  },
  {
    id: 'private', tok: 'red', title: 'Private by design',
    time: '08:52', date: 'Jun 06, 2026 · 08:52', mode: 'rich',
    tags: [{ name: 'Privacy', tok: 'red' }],
    body: [
      { t: 'p', html: 'Your notes, your rules. Sync runs through a repo <strong>you</strong> own, and you can plug in <strong>local AI models</strong> so nothing ever leaves your machine.' },
      { t: 'check', items: [
        { done: true, text: 'Sync to a GitHub repo you control' },
        { done: true, text: 'Run local LLMs — fully offline AI' },
        { done: true, text: 'Your keys, your data, your disk' },
      ] },
    ],
  },
];
const firstFeature = noteFeatures[0];
---

<Base jsonLd={jsonLd}>
  <div data-root style="position:relative;width:100%;background:var(--bg);">
    <nf-netbg style="position:fixed;inset:0;z-index:0;pointer-events:none;"></nf-netbg>

    <!-- Vertical neuron rail -->
    <nav
      class="nf-rail"
      data-labels
      style="position:fixed;top:0;left:0;bottom:0;z-index:60;width:80px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:26px 0;background:var(--nav-bg, transparent);border-right:1px solid var(--line);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);"
    >
      <span
        style="position:absolute;left:50%;top:96px;bottom:96px;width:1px;transform:translateX(-.5px);background:linear-gradient(180deg,transparent,var(--line-2) 14%,var(--line-2) 86%,transparent);"
      ></span>

      <a href="#top" data-nav="home" class="nf-neuron" style="--c:var(--ink-strong);display:flex;align-items:center;justify-content:center;width:100%;height:52px;color:var(--c);">
        <svg class="nf-soma" width="30" height="30" viewBox="-15 -15 30 30" fill="none" stroke="currentColor" stroke-linecap="round">
          <circle cx="0" cy="0" r="8" stroke-width="1.5" opacity=".5"></circle>
          <circle class="nf-fill" cx="0" cy="0" r="3.4" fill="currentColor" stroke="none" opacity=".78"></circle>
        </svg>
        <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);"><b style="font-weight:600;letter-spacing:.04em;">NoteFlow</b> · home</span>
      </a>

      <div style="display:flex;flex-direction:column;align-items:center;gap:30px;">
        <a href="#brain" data-nav="brain" class="nf-neuron" style="--c:rgb(var(--purple));display:flex;align-items:center;justify-content:center;width:100%;height:34px;color:var(--c);">
          <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
            <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity=".72"></circle>
          </svg>
          <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);">The Brain</span>
        </a>
        <a href="#notes" data-nav="notes" class="nf-neuron" style="--c:rgb(var(--accent));display:flex;align-items:center;justify-content:center;width:100%;height:34px;color:var(--c);">
          <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
            <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity=".72"></circle>
          </svg>
          <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);">Notes</span>
        </a>
        <a href="#profile" data-nav="profile" class="nf-neuron" style="--c:rgb(var(--orange));display:flex;align-items:center;justify-content:center;width:100%;height:34px;color:var(--c);">
          <svg class="nf-soma" width="26" height="26" viewBox="-13 -13 26 26" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="0" cy="0" r="7" stroke-width="1.4" opacity=".5"></circle>
            <circle class="nf-fill" cx="0" cy="0" r="3" fill="currentColor" stroke="none" opacity=".72"></circle>
          </svg>
          <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);">Profile</span>
        </a>
      </div>

      <div style="display:flex;flex-direction:column;align-items:center;gap:22px;">
        <a href="#get" data-nav="download" class="nf-neuron" style="--c:rgb(var(--accent-2));display:flex;align-items:center;justify-content:center;width:100%;height:40px;color:var(--c);">
          <svg class="nf-soma" width="30" height="30" viewBox="-15 -15 30 30" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="0" cy="0" r="8" stroke-width="1.5" opacity=".5"></circle>
            <circle class="nf-fill" cx="0" cy="0" r="3.4" fill="currentColor" stroke="none" opacity=".78"></circle>
          </svg>
          <span class="nf-label" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink);text-shadow:0 1px 12px var(--bg),0 0 4px var(--bg);">Download</span>
        </a>
        <button data-theme-toggle aria-label="Toggle theme" class="nf-neuron nf-theme-btn" style="--c:var(--ink-dim);display:grid;place-items:center;width:36px;height:36px;border-radius:8px;border:1px solid var(--line-2);background:transparent;color:var(--ink);cursor:pointer;font-size:14px;font-family:'JetBrains Mono',monospace;">
          <span class="nf-theme-icon">☀</span>
        </button>
      </div>
    </nav>

    <!-- Hero -->
    <header id="top" style="position:relative;min-height:100svh;display:flex;align-items:center;overflow:hidden;background:var(--hero-bg);">
      <noteflow-brain id="heroBrain" class="nf-brain-hero" data-ambient data-content-edges="true" data-cam="1.9" data-rotate-speed="0.4" data-shift-x="0.08" data-target-y="-0.04" style="position:absolute;inset:0;width:100%;height:100%;opacity:.82;"></noteflow-brain>
      <div style="position:absolute;inset:0;pointer-events:none;background:var(--hero-scrim);"></div>
      <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(0deg,var(--bg) 0%,transparent 26%);"></div>

      <div style="position:relative;z-index:3;max-width:1320px;margin:0 auto;padding:96px clamp(22px,5vw,64px) 0;width:100%;">
        <div class="nf-hero-copy" style="max-width:600px;">
          <div style={`display:flex;align-items:center;gap:13px;font-size:11.5px;letter-spacing:.28em;text-transform:uppercase;font-family:'JetBrains Mono',monospace;color:var(--ink-faint);animation:riseIn .8s .05s both;`}>
            <span style="width:22px;height:1px;background:var(--detail);display:inline-block;"></span>NoteFlow · The Brain
          </div>
          <h1 class="nf-hero-title" style="margin:26px 0 0;font-size:clamp(56px,8.4vw,120px);line-height:.96;letter-spacing:-.022em;font-weight:500;color:var(--ink-strong);animation:riseIn .9s .12s both;">Notes with<br />a <em style="font-style:italic;font-weight:500;">brain.</em></h1>
          <span style="display:block;width:76px;height:3px;margin-top:24px;background:var(--detail);border-radius:2px;animation:riseIn .9s .2s both;"></span>
          <p style="margin:28px 0 0;font-style:italic;font-size:clamp(20px,1.8vw,27px);line-height:1.4;color:var(--ink-faint);animation:riseIn .9s .3s both;">Our niche is people with taste.</p>
          <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:40px;animation:riseIn .9s .38s both;">
            <a href="#brain" data-nav="brain" class="nf-ghost" style="display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:14px;letter-spacing:.02em;color:var(--ink);background:transparent;border:1px solid var(--line-2);padding:15px 24px;border-radius:5px;">Explore the brain ↓</a>
          </div>
        </div>
      </div>

      <div style="position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--ink-faint);">
        <span>Scroll</span>
        <span style="width:1px;height:32px;background:linear-gradient(var(--ink-faint),transparent);animation:bob 2.1s ease-in-out infinite;"></span>
      </div>
    </header>

    <main style="position:relative;z-index:2;background:transparent;">
      <!-- Notes -->
      <section id="notes" style="max-width:1240px;margin:0 auto;padding:clamp(90px,12vw,150px) clamp(22px,5vw,64px);">
        <div data-reveal style="max-width:760px;">
          <div style={`display:flex;align-items:center;gap:11px;margin-bottom:22px;${label}`}><span style="width:18px;height:1px;background:rgb(var(--accent));"></span>What is NoteFlow</div>
          <h2 style="margin:0;font-size:clamp(34px,5vw,60px);line-height:1.05;letter-spacing:-.015em;font-weight:500;color:var(--ink-strong);">Quick notes. Zero friction.</h2>
          <p style="margin:24px 0 0;font-size:clamp(19px,1.5vw,22px);line-height:1.62;color:var(--ink-dim);">A dark-first desktop notebook for developers. It lives in your system tray, writes plain Markdown to your own disk, and stays out of the way until you need it. The brain is optional — the speed isn't.</p>
        </div>

        <!-- Two floating things, separated only by space: a list of NoteFlow note
             items (left, identical to the real dark sidebar) and the section-preview
             card for the picked note (right). No window chrome — just the pieces. -->
        <div class="nf-notes" data-reveal data-noteapp>
          <!-- ── The clickable notes — a faithful slice of the NoteFlow sidebar ── -->
          <div class="nf-note-list" role="tablist" aria-label="NoteFlow features">
            {noteFeatures.map((f) => (
              <button
                type="button"
                role="tab"
                aria-selected={f.id === firstFeature.id ? 'true' : 'false'}
                class={`nf-note${f.id === firstFeature.id ? ' is-active' : ''}`}
                data-note={f.id}
                style={`--ac:var(--nf-${f.tok});`}
                aria-label={f.title}
              >
                <span class="nf-note-top">
                  <span class="nf-note-title">{f.title}</span>
                  <span class="nf-note-time">{f.time}</span>
                </span>
                <span class="nf-note-tags">
                  {f.tags.map((tg) => (
                    <span class="nf-note-tag" style={`--tc:var(--nf-${tg.tok});`}>{tg.name}</span>
                  ))}
                </span>
              </button>
            ))}
          </div>

          <!-- ── The note content — a floating section-preview card that swaps ── -->
          <div class="nf-card-stage" data-noteapp-stage>
            {noteFeatures.map((f) => (
              <article
                class={`nf-card${f.id === firstFeature.id ? ' is-active' : ''}`}
                data-panel={f.id}
                style={`--ac:var(--nf-${f.tok});`}
                aria-hidden={f.id === firstFeature.id ? 'false' : 'true'}
              >
                {/* Section label — the card's identity (which tab this is) */}
                <div class="nf-card-sec">
                  <span class="nf-card-sec-dot"></span>
                  <span class="nf-card-sec-name">{f.tags[0].name}</span>
                  <span class="nf-card-sec-mode" title={f.mode === 'raw' ? 'Raw markdown section' : 'Rich text section'}>{f.mode === 'raw' ? '✎' : '◉'}</span>
                </div>

                {/* Editor mock — title, date, a representational toolbar, then the body */}
                <div class="nf-card-doc">
                  <div class="nf-card-rise nf-card-head">
                    <div class="nf-card-title">{f.title}<span class="nf-card-caret"></span></div>
                    <div class="nf-card-date">{f.date}</div>
                  </div>
                  <div class="nf-card-rise nf-card-toolbar" aria-hidden="true">
                    {Array.from({ length: 6 }).map(() => <span></span>)}
                  </div>

                  <div class="nf-card-body">
                    {f.body.map((b) => {
                      if (b.t === 'p') return <p class="nf-card-rise nf-card-p" set:html={b.html} />;
                      if (b.t === 'ul') return (
                        <ul class="nf-card-rise nf-card-ul">
                          {b.items.map((it) => <li set:html={it} />)}
                        </ul>
                      );
                      if (b.t === 'check') return (
                        <ul class="nf-card-rise nf-card-check">
                          {b.items.map((it) => (
                            <li class={it.done ? 'is-done' : ''}><span class="nf-card-box">{it.done ? '✓' : ''}</span>{it.text}</li>
                          ))}
                        </ul>
                      );
                      if (b.t === 'kbd') return (
                        <div class="nf-card-rise nf-card-kbd">
                          {b.keys.map((k, i) => (
                            <>{i > 0 && <span class="nf-card-kbd-plus">+</span>}<kbd>{k}</kbd></>
                          ))}
                        </div>
                      );
                      if (b.t === 'code') return (
                        <pre class="nf-card-rise nf-card-code"><code>{b.lines.join('\n')}</code></pre>
                      );
                      if (b.t === 'tabs') return (
                        <div class="nf-card-rise nf-card-tabs">
                          {b.tabs.map((tb) => (
                            <span class="nf-card-tab" style={`--tc:var(--nf-${tb.tok});`}><span class="nf-card-tab-dot"></span>{tb.name}</span>
                          ))}
                        </div>
                      );
                      if (b.t === 'groups') return (
                        <div class="nf-card-rise nf-card-grouprows">
                          {b.rows.map((r) => (
                            <div class="nf-card-grouprow" style={`--tc:var(--nf-${r.tok});`}>
                              <span class="nf-card-grouprow-dot"></span>
                              <span class="nf-card-grouprow-name">{r.name}</span>
                              <span class="nf-card-grouprow-count">{r.count}</span>
                            </div>
                          ))}
                        </div>
                      );
                      return null;
                    })}
                  </div>

                  {/* Bottom fade — suggests there's more below the fold (like the real card) */}
                  <div class="nf-card-fade" aria-hidden="true"></div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Showcase -->
      <section style="position:relative;background:transparent;border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;">
        <div style="max-width:1240px;margin:0 auto;padding:clamp(90px,12vw,150px) clamp(22px,5vw,64px);">
          <div data-reveal style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:28px;">
            <div style="max-width:660px;">
              <div style={`display:flex;align-items:center;gap:11px;margin-bottom:22px;${label}`}><span style="width:18px;height:1px;background:rgb(var(--pink));"></span>Dark-first · 12 themes</div>
              <h2 style="margin:0;font-size:clamp(34px,5vw,60px);line-height:1.05;letter-spacing:-.015em;font-weight:500;color:var(--ink-strong);">The magic is in <em style="font-style:italic;">the small details.</em></h2>
              <p style="margin:24px 0 0;font-size:clamp(19px,1.5vw,22px);line-height:1.6;color:var(--ink-dim);">Twelve hand-tuned themes — Carbon, Tokyo Night, Dracula, Parchment and more. Flip the switch and the whole app follows.</p>
            </div>
            <button data-theme-toggle class="nf-edge" style="display:inline-flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.04em;color:var(--ink);background:var(--card);border:1px solid var(--line-2);border-radius:5px;padding:12px 16px;cursor:pointer;">
              <span style="width:9px;height:9px;border-radius:50%;background:var(--detail);box-shadow:0 0 12px var(--detail);"></span>Toggle theme <span class="nf-theme-icon">☀</span>
            </button>
          </div>

          <div data-reveal style="position:relative;margin-top:clamp(46px,6vw,72px);">
            <div style="position:absolute;inset:-8% -4% -14%;background:radial-gradient(60% 60% at 50% 40%,rgb(var(--accent)/.16),transparent 70%);filter:blur(30px);pointer-events:none;"></div>
            <div style="position:relative;border:1px solid var(--line-2);border-radius:14px;overflow:hidden;box-shadow:0 40px 100px -30px rgba(0,0,0,.5);background:var(--card);">
              <video data-shot
                data-shot-dark={VID_DARK} data-shot-dark-webm={VID_DARK_WEBM} data-shot-dark-poster={SHOT_DARK}
                data-shot-light={VID_LIGHT} data-shot-light-webm={VID_LIGHT_WEBM} data-shot-light-poster={SHOT_LIGHT}
                poster={SHOT_DARK} autoplay muted loop playsinline preload="metadata"
                aria-label="NoteFlow desktop app demo" width="1279" height="820"
                style="display:block;width:100%;height:auto;">
                <source data-shot-webm src={VID_DARK_WEBM} type="video/webm" />
                <source data-shot-mp4 src={VID_DARK} type="video/mp4" />
              </video>
            </div>
          </div>

          <div data-reveal style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:28px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-faint);">
