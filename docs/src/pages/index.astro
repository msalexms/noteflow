            <div style="flex:0 0 auto;display:flex;align-items:center;justify-content:center;min-width:120px;">
              <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
                <div style="display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;font-weight:500;font-size:12.5px;letter-spacing:.02em;color:var(--bg);background:rgb(var(--orange));padding:11px 18px;border-radius:5px;box-shadow:0 10px 30px rgb(var(--orange)/.3);">✦ Generate profile</div>
